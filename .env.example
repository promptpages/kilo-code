# ============================================
# KILO AI — Environment Variables (Secrets)
# ============================================
# Put these in Vercel → Project Settings → Environment Variables
# OR in a local .env.local file (never commit real keys)
#
# Variable names below are EXACTLY what the code expects.
# ============================================

# Groq API Key (primary — faster responses)
# Get it from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here

# OpenRouter API Key (fallback if Groq is slow / fails)
# Get it from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1_your_openrouter_key_here

# Optional: override default models
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=openai/gpt-4o-mini
